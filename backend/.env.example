# ---------- ฐานข้อมูล ----------
# ค่านี้ตรงกับ docker-compose.yml (เฉพาะเครื่องพัฒนา) ถ้าใช้งานจริงให้เปลี่ยนรหัสผ่าน
DATABASE_URL="postgresql://123456@localhost:5432/prayer_attendance?schema=public"

# ---------- เซิร์ฟเวอร์ ----------
PORT=3000
# หน้าเว็บ React ที่อนุญาตให้เรียก API (คั่นหลายค่าด้วยจุลภาค)
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Bangkok

# ---------- ความปลอดภัย ----------
# สุ่มสร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ต้องยาวอย่างน้อย 32 ตัวอักษร
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---------- บัญชีแอดมินเริ่มต้น (ใช้ตอน npm run seed) ----------
ADMIN_USERNAME=admin
# ถ้าเว้นว่าง seed จะสุ่มรหัสผ่านให้และแสดงครั้งเดียวในหน้าจอ
ADMIN_PASSWORD=123456789
# true = สร้างห้องเรียน/นักเรียน/อุปกรณ์ตัวอย่างสำหรับทดสอบ
SEED_DEMO=false

# ---------- การคำนวณเวลาละหมาด ----------
# พิกัดของโรงเรียน (ต้องตั้งค่า ไม่เช่นนั้นระบบสร้างตารางเวลาอัตโนมัติไม่ได้)
# หาได้จาก Google Maps: คลิกขวาที่ตำแหน่งโรงเรียนแล้วคัดลอกตัวเลข
PRAYER_LATITUDE=
PRAYER_LONGITUDE=

# วิธีคำนวณ: MuslimWorldLeague, Egyptian, Karachi, UmmAlQura, Dubai, MoonsightingCommittee,
#            NorthAmerica, Kuwait, Qatar, Singapore, Tehran, Turkey
# ควรตรวจสอบกับผู้รู้/คณะกรรมการอิสลามในพื้นที่ว่าใช้ตารางเวลาแบบไหน
PRAYER_METHOD=Singapore
# shafi หรือ hanafi (มีผลกับเวลาอัศรี)
PRAYER_MADHAB=shafi

# ละหมาดที่ต้องลงเวลา (fajr,dhuhr,asr,maghrib,isha)
PRAYERS=dhuhr,asr
# วันศุกร์ให้เปลี่ยนช่วงซุฮ์รีเป็นละหมาดญุมุอะฮ์ (jumuah)
JUMUAH_ON_FRIDAY=true

# ช่วงรับแตะบัตร (หน่วยนาที เทียบกับเวลาเข้าละหมาด)
WINDOW_OPEN_BEFORE_MIN=15
WINDOW_LATE_AFTER_MIN=30
WINDOW_CLOSE_AFTER_MIN=60

# สร้างตารางเวลาของวันนี้และพรุ่งนี้ให้อัตโนมัติ (ต้องตั้งพิกัดก่อน)
AUTO_GENERATE_WINDOWS=true
