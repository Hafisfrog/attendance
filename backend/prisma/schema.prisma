// Prisma schema ที่แมปกับตารางใน database/schema.sql
// หมายเหตุ: ฐานข้อมูลถูกสร้างจาก schema.sql (มี CHECK constraint และ view)
// ใช้ Prisma เป็น client อย่างเดียว => รัน `prisma generate` ไม่ต้องใช้ `prisma migrate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name") @db.VarChar(100)
  role         String   @default("teacher") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  homeroomClassrooms Classroom[]
  attendanceUpdates  Attendance[]

  @@map("users")
}

model Classroom {
  id                Int    @id @default(autoincrement())
  name              String @db.VarChar(50)
  academicYear      Int    @map("academic_year") @db.SmallInt
  homeroomTeacherId Int?   @map("homeroom_teacher_id")

  homeroomTeacher User?     @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students        Student[]

  @@unique([name, academicYear])
  @@map("classrooms")
}

model Student {
  id          Int      @id @default(autoincrement())
  studentCode String   @unique @map("student_code") @db.VarChar(20)
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  gender      String?  @db.Char(1)
  classroomId Int?     @map("classroom_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  classroom  Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  cards      Card[]
  tapLogs    TapLog[]
  attendance Attendance[]

  @@index([classroomId], map: "idx_students_classroom")
  @@map("students")
}

model Card {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @db.VarChar(32)
  studentId Int?     @map("student_id")
  status    String   @default("active") @db.VarChar(20)
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  note      String?

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  tapLogs TapLog[]

  @@index([studentId], map: "idx_cards_student")
  @@map("cards")
}

model Device {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  location   String?   @db.VarChar(200)
  apiKeyHash String    @map("api_key_hash")
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tapLogs    TapLog[]
  attendance Attendance[]

  @@map("devices")
}

model PrayerWindow {
  id         Int       @id @default(autoincrement())
  prayerDate DateTime  @map("prayer_date") @db.Date
  prayer     String    @db.VarChar(10)
  opensAt    DateTime  @map("opens_at") @db.Timestamptz(6)
  lateAt     DateTime? @map("late_at") @db.Timestamptz(6)
  closesAt   DateTime  @map("closes_at") @db.Timestamptz(6)

  attendance Attendance[]

  @@unique([prayerDate, prayer])
  @@map("prayer_windows")
}

model TapLog {
  id         BigInt   @id @default(autoincrement())
  cardUid    String   @map("card_uid") @db.VarChar(32)
  cardId     Int?     @map("card_id")
  studentId  Int?     @map("student_id")
  deviceId   Int      @map("device_id")
  tappedAt   DateTime @map("tapped_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  result     String   @db.VarChar(20)

  card       Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  student    Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  device     Device       @relation(fields: [deviceId], references: [id])
  attendance Attendance[]

  @@index([tappedAt], map: "idx_tap_logs_tapped_at")
  @@index([cardUid], map: "idx_tap_logs_card_uid")
  @@index([studentId], map: "idx_tap_logs_student")
  @@map("tap_logs")
}

model Attendance {
  id             BigInt   @id @default(autoincrement())
  studentId      Int      @map("student_id")
  prayerWindowId Int      @map("prayer_window_id")
  tapLogId       BigInt?  @map("tap_log_id")
  deviceId       Int?     @map("device_id")
  tappedAt       DateTime @map("tapped_at") @db.Timestamptz(6)
  status         String   @default("present") @db.VarChar(10)
  note           String?
  facePhoto      String?  @map("face_photo") @db.Text
  updatedById    Int?     @map("updated_by")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  prayerWindow PrayerWindow @relation(fields: [prayerWindowId], references: [id], onDelete: Cascade)
  tapLog       TapLog?      @relation(fields: [tapLogId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id])
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([studentId, prayerWindowId])
  @@index([prayerWindowId], map: "idx_attendance_window")
  @@map("attendance")
}
